; Canonical authored Horizon input. Maps are named vectors because Datom has
; positional structs and vectors, not a map primitive.
Signal
; imports: Horizon names no other contract
[]
; queries: Horizon answers no query on a wire
[]
; responses: Horizon sends no response on a wire
[]
; types: every record the authored configuration, cluster definition and
; composed Horizon definition are read as
[ NodeName.String
  ClusterName.String
  UserName.String
  DomainName.String
  ModelName.String
  Location.String
  Latitude.Decimal
  Longitude.Decimal
  Altitude.Decimal
  Accuracy.Decimal
  Interface.String
  WirelessNetworkName.String
  CountryCode.String
  Ipv4Cidr.String
  SecretName.String
  ; a sops secret, named
  SecretReference.{ SecretName }
  CertificateAuthority.String
  ; the sops secret holding a TLS certificate
  TlsCertificateReference.{ SecretName }
  ; the sops secret holding a TLS private key
  TlsKeyReference.{ SecretName }
  GithubId.String
  Keygrip.String
  DevicePath.String
  MountPath.String
  SshPubKey.String
  NixPubKey.String
  WireguardPubKey.String
  YggPubKey.String
  YggAddress.String
  YggSubnet.String
  LinkLocalIp.String
  NodeIp.String
  TapSubnet.String
  SiteSource.String
  ServedDomain.String
  ; the work a user does: Code or Unlimited makes a code developer,
  ; Multimedia or Unlimited a multimedia developer
  UserRole.[ Code Multimedia Unlimited ]
  ; a machine's processor architecture
  Architecture.[ X86_64 Arm64 ]
  ; the size-and-trust ladder, from Zero up to Max
  Magnitude.[ Zero Min Medium Large Max ]
  ; a keyboard layout
  Keyboard.[ Qwerty Colemak ]
  ; a user's editing keybinding style
  Style.[ Vim Emacs ]
  ; a user's preferred editor
  Editor.[ Codium Emacs ]
  ; a user's text size
  TextSize.[ ExtraSmall Small Medium Large ExtraLarge ]
  ; how an installed node boots
  Bootloader.[ Uefi Mbr Uboot ]
  ; a known motherboard
  MotherBoard.[ Undefined ]
  ; who serves a public domain's DNS
  DomainProvider.[ Cloudflare ]
  ; a wireless frequency band
  WlanBand.[ TwoG FiveG SixG ]
  ; a wireless standard
  WlanStandard.[ Wifi4 Wifi6 Wifi7 ]
  ; whether a virtual machine host offers KVM
  KvmAvailability.[ Available Absent ]
  ; how a hosted site is rendered
  SiteRenderer.[ MarkdownStatic ]
  ; a disk's filesystem
  FsType.[ Ext2 Ext3 Ext4 Btrfs Xfs Zfs F2fs Bcachefs Vfat Exfat Ntfs Tmpfs ]
  ; core count, model, motherboard, chip generation, RAM in GiB, location
  Hardware.{ Integer Option<ModelName> Option<MotherBoard> Option<Integer> Option<Integer> Option<Location> }
  ; where a virtual machine runs: on a cluster node (its host, further
  ; hosts, the user that runs it, an architecture other than the host's),
  ; or outside the cluster (the provider's place and the architecture)
  VirtualMachineHost.[ Cluster.{ NodeName Vector<NodeName> Option<UserName> Option<Architecture> } External.{ String Architecture } ]
  ; a machine: metal (architecture and hardware) or a virtual machine
  ; (its host, hardware and disk size in GiB)
  MachineDefinition.[ Metal.{ Architecture Hardware } VirtualMachine.{ VirtualMachineHost Hardware Option<Integer> } ]
  ; a disk: device, mount point, filesystem, mount options
  DiskLayout.{ DevicePath MountPath FsType Vector<String> }
  ; a swap device and its size in MiB
  SwapDevice.{ DevicePath Option<Integer> }
  ; compressed swap, as a percent of memory
  CompressedSwap.{ Integer }
  ; latitude, longitude, altitude, accuracy
  FixedLocation.{ Decimal Decimal Decimal Decimal }
  ; the node's keyboard and compressed swap
  NodeEnvironment.{ Keyboard Option<CompressedSwap> }
  ; an installed node's bootloader, disks and swap devices
  Installation.{ Bootloader Vector<DiskLayout> Vector<SwapDevice> }
  ; a live node carries no persistent layout
  LiveDefinition.{}
  ; whether a node runs live or installed
  NodeVariant.[ Live.LiveDefinition Installation.Installation ]
  ; a node's Yggdrasil public key, address and subnet
  YggdrasilKey.{ YggPubKey YggAddress YggSubnet }
  ; a node's SSH, Nix signing and Yggdrasil keys
  NodeKeys.{ SshPubKey Option<NixPubKey> Option<YggdrasilKey> }
  ; a WireGuard proxy: its public key, endpoint and interface address
  WireguardProxy.{ WireguardPubKey String NodeIp }
  ; a router's backup wireless: interface, network name, band, channel,
  ; standard, and the secret holding its password
  BackupWireless.{ Interface WirelessNetworkName WlanBand Integer WlanStandard SecretReference }
  ; a router's WAN and WLAN interfaces, band, channel, standard, WPA3
  ; password secret, backup wireless, and regulatory country
  RouterInterfaces.{ Interface Interface WlanBand Integer WlanStandard Option<SecretReference> Option<BackupWireless> CountryCode }
  ; a node's link-local addresses, node address, WireGuard key, WireGuard
  ; proxies and router interfaces
  NodeNetwork.{ Vector<LinkLocalIp> Option<NodeIp> Option<WireguardPubKey> Vector<WireguardProxy> Option<RouterInterfaces> }
  ; a site a node serves: its domain, source and renderer
  HostedSite.{ ServedDomain SiteSource SiteRenderer }
  ; what a Persona development node serves
  PersonaCapability.[ GitoliteServer ]
  ; a capability with nothing to configure
  NoSettings.{}
  ; a role a node takes on, with the data it needs; OpenCodeTesting names
  ; the user who runs the node's OpenCode server and owns its password
  NodeCapability.[ Graphical.NoSettings Center.NoSettings LargeAi.NoSettings Router.NoSettings Edge.NoSettings NextGeneration.NoSettings LowPower.NoSettings TestVm.NoSettings VmTesting.{ Boolean String Option<String> } CloudNode.NoSettings Printing.NoSettings HardwareVideo.NoSettings Nordvpn.NoSettings WifiCertificate.NoSettings TailnetClient.SecretReference TailnetController.{ Option<CertificateAuthority> TlsCertificateReference TlsKeyReference } NixBuilder.Option<Integer> NixCache.NoSettings OpenCodeTesting.UserName PersonaDevelopment.Vector<PersonaCapability> VmHost.{ TapSubnet KvmAvailability Option<Integer> } WebHost.Vector<HostedSite> UsbDownlink.{ Ipv4Cidr } GitServer.NoSettings ]
  Capabilities.Vector<NodeCapability>
  ; a node: name, variant, size, trust, machine, environment, network,
  ; keys, whether it is online, capabilities, fixed location
  NodeDefinition.{ NodeName NodeVariant Magnitude Magnitude MachineDefinition NodeEnvironment NodeNetwork NodeKeys Option<Boolean> Capabilities Option<FixedLocation> }
  GenericNodeNames.Vector<NodeName>
  GenericNodes.Vector<NodeDefinition>
  ClusterNodes.Vector<NodeDefinition>
  ; what a user runs on one node: AgentStack runs the agent stack
  ; (Curriculum, Flow Nexus, the Codex servers); CodexCandidate runs the
  ; codex-next candidate server for that user; StableCodex makes the
  ; user's Codex client the stable core package, and the user's next
  ; Codex home is never seeded from ~/.codex
  UserCapability.[ AgentStack CodexCandidate StableCodex ]
  ; a user's entry for one node: the node, the user's SSH key and GPG
  ; keygrip there, and what the user runs there
  UserPubKey.{ NodeName SshPubKey Keygrip Vector<UserCapability> }
  ; a user: name, role, size, keyboard, style, GitHub id, fast key repeat,
  ; per-node entries, editor, text size
  UserDefinition.{ UserName UserRole Magnitude Keyboard Style Option<GithubId> Option<Boolean> Vector<UserPubKey> Option<Editor> Option<TextSize> }
  Users.Vector<UserDefinition>
  ; a public domain and who serves its DNS
  DomainDefinition.{ DomainName DomainProvider }
  Domains.Vector<DomainDefinition>
  ; the trust given to another cluster
  ClusterTrustEntry.{ ClusterName Magnitude }
  ; the trust given to a node
  NodeTrustEntry.{ NodeName Magnitude }
  ; the trust given to a user
  UserTrustEntry.{ UserName Magnitude }
  ; the cluster's own trust, which caps every entry, and the entries for
  ; clusters, nodes and users
  ClusterTrust.{ Magnitude Vector<ClusterTrustEntry> Vector<NodeTrustEntry> Vector<UserTrustEntry> }
  ; the internal domain suffix and the public domains
  DomainConfiguration.{ String Vector<DomainName> }
  ; a cluster: name, local nodes, selected generic node names, users,
  ; domains, trust
  ClusterDefinition.{ ClusterName ClusterNodes GenericNodeNames Users Domains ClusterTrust }
  ; the generic node catalogue and the domain settings
  HorizonConfiguration.{ GenericNodes DomainConfiguration }
  ; the composed definition: configuration and cluster
  HorizonDefinition.{ HorizonConfiguration ClusterDefinition }
  ; the configuration path and the cluster definition path
  CompositionRequest.{ String String }
  ; the one command horizon-compose takes
  CompositionCommand.[ Compose.CompositionRequest ] ]
